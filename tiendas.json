<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tu Romo Aquí</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:Arial,sans-serif;background:#f5f5f5}
header{background:#ff6b00;color:white;padding:15px;display:flex;align-items:center;justify-content:space-between}
header h1{font-size:22px}
header p{font-size:12px}
header img{width:80px;height:80px;border-radius:50%;object-fit:cover;border:3px solid white}
.banner{background:#00c853;color:white;text-align:center;padding:20px 15px}
.banner a{display:block;background:white;color:#00c853;font-weight:bold;font-size:18px;text-align:center;padding:15px;margin-top:15px;border-radius:12px;text-decoration:none}
#map{height:450px;width:100%}
.marcador{font-size:32px;text-align:center;text-shadow:0 2px 5px rgba(0,0,0,.4)}
.titilando{animation:titila 1s infinite}
@keyframes titila{0%{transform:scale(1)}50%{transform:scale(1.5);opacity:.5}100%{transform:scale(1)}}
</style>
</head>
<body>

<header>
<div>
<h1>🍾 Tu Romo Aquí</h1>
<p>📍 El Punto Liquor Store - San Isidro</p>
</div>
<img src="IMG_7927.jpeg">
</header>

<div class="banner">
<h2>⭐ EL PUNTO LIQUOR STORE</h2>
<p>C. 19, Aut. San Isidro, frente Hotel Golden House</p>
<p>🟢 ABIERTO - Cierra 12:05 a.m.</p>
<a href="https://www.google.com/maps/dir/?api=1&destination=18.485748,-69.843905" target="_blank">📍 Cómo Llegar</a>
</div>

<div id="map"></div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
var map = L.map('map').setView([18.485748,-69.843905],14);
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);

// Botellita titilando = El Punto
var botella = L.divIcon({className:'', html:'<div class="marcador titilando">🍾</div>', iconSize:[50,50], iconAnchor:[25,40]});
L.marker([18.485748,-69.843905], {icon: botella}).addTo(map).bindPopup("🍾 <b>El Punto Liquor Store</b><br>Aut. San Isidro").openPopup();

// Carita borracha = Tú
var borracho = L.divIcon({className:'', html:'<div class="marcador" style="font-size:38px">🥴</div>', iconSize:[45,45], iconAnchor:[22,40]});
if(navigator.geolocation){
navigator.geolocation.getCurrentPosition(p=>{
L.marker([p.coords.latitude,p.coords.longitude], {icon: borracho}).addTo(map).bindPopup("🥴 Tú estás aquí");
});
}
</script>
</body>
</html>